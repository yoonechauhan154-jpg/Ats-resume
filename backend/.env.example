# --- AI integration ---------------------------------------------------------
# PRIMARY provider: TokenRouter (OpenAI-compatible). The app falls back to a
# local Ollama server if this key is missing or the request fails/rate-limits.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=moonshotai/kimi-k3-free

# FALLBACK provider: local Ollama (no key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Rate limiting -----------------------------------------------------------
# Optional. When empty, an in-memory limiter is used (fine for single instance).
REDIS_URL=
RATE_LIMIT_PER_DAY=5

# Optional Upstash Redis REST credentials (for the async rate limiter).
# Grab these from the Upstash console -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anonymous analytics (optional). NEVER contains resume content ------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Files / privacy ----------------------------------------------------------
MAX_UPLOAD_MB=5
TEMP_DIR=/tmp/ats_optimizer
# Always keep true: delete the resume file as soon as it has been parsed.
DELETE_AFTER_SCAN=true

# --- CORS ---------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","https://*.vercel.app","https://*.monkeycode-ai.live"]
